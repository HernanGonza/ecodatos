############
# Auth - Configuration for the GoTrue authentication server.
############

SITE_URL=https://ecodatos.ecologia.misiones.gob.ar
ADDITIONAL_REDIRECT_URLS=https://ecodatos.ecologia.misiones.gob.ar
JWT_EXPIRY=3600
DISABLE_SIGNUP=false
API_EXTERNAL_URL=https://ecodatos.ecologia.misiones.gob.ar

## Mailer Config
MAILER_URLPATHS_CONFIRMATION="/auth/v1/verify"
MAILER_URLPATHS_INVITE="/auth/v1/verify"
MAILER_URLPATHS_RECOVERY="/auth/v1/verify"
MAILER_URLPATHS_EMAIL_CHANGE="/auth/v1/verify"

## Email auth
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=true
SMTP_ADMIN_EMAIL=eco.datos.sot@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=eco.datos.sot@gmail.com
SMTP_PASS=pdoq mtvz rkmf konk
SMTP_SENDER_NAME=Eco Datos
ENABLE_ANONYMOUS_USERS=false

## Phone auth
ENABLE_PHONE_SIGNUP=true
ENABLE_PHONE_AUTOCONFIRM=true


